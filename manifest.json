{
  "manifest_version": 3,
  "name": "Netflix Outro Music",
  "version": "1.0",
  "description": "Mutes Netflix and plays a YouTube/YouTube Music track when the Skip Credits button appears on a chosen show.",
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": ["https://www.netflix.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["defaults.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "relax_csp", "enabled": true, "path": "rules.json" }
    ]
  },
  "action": { "default_popup": "popup.html", "default_title": "Netflix Outro Music" }
}
